# MongoDB connection string (use MongoDB Atlas for Vercel)
MONGODB_URI=mongodb://127.0.0.1:27017/jwt_db

# Long random string used to sign JWTs (required on Vercel)
JWT_SECRET=change-me-to-a-long-random-string

# Access token lifetime (jsonwebtoken format) and how many days an unused session lives
ACCESS_TOKEN_TTL=15m
SESSION_TTL_DAYS=7

# Allowed frontend origin(s), comma separated. Leave empty to allow all.
CORS_ORIGIN=http://localhost:5173

# Admin account created on first start
ADMIN_EMAIL=chanderlalpiter0@gmail.com
ADMIN_PASSWORD=admin

PORT=5000

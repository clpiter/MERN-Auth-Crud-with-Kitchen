# Used by `npm run build` (and Vercel) when VITE_API_URL isn't set in the environment.
# Production domain of the backend: per-deployment URLs (…-<hash>-piter-computer-works.vercel.app)
# are behind Vercel Authentication and fail with "NetworkError".
VITE_API_URL=https://mern-auth-crud-with-kitchen.vercel.app
